+        # out_proj: fp8 [hidden, value_dim] -> dequant -> LinearBase.weight
+        # [value_dim, hidden] (transpose), sharded ("tensor", None).
+        out_w = _deq("out_proj")  # [hidden, value_dim]
+        gdn.out_proj.weight.value = self._put(out_w.T, ("tensor", None))
