+    def _np_block_dequant(w_fp8, scale, block: int = 128):
+        """Block-dequant an fp8 weight [out, in] with a 2D multiplicative
+        weight_scale_inv [out/block, in/block] -> float32 [out, in].
+
+        The Qwen3.5-FP8 checkpoint stores dequant = fp8 * weight_scale_inv over
+        128x128 blocks. Returns float32 (``_put`` casts to the model dtype).
+        """
+        w = np.asarray(w_fp8).astype(np.float32)
+        s = np.asarray(scale).astype(np.float32)
+        out, inn = w.shape
+        s_full = np.repeat(np.repeat(s, block, axis=0), block, axis=1)[:out, :inn]
+        return w * s_full
+
+    def _load_gdn_layer_fp8(self, fm, weight_info, layer_idx, tp):
+        """Static-fp8 GDN load. in_proj_qkv / in_proj_z / out_proj are stored
+        fp8 + weight_scale_inv but the GDN backend + LinearBase run in bf16
+        (config's modules_to_not_convert keeps GDN unquantized), so dequantize
+        them here. in_proj_a / in_proj_b / conv1d stay bf16.
+        """
+        src = f"model.language_model.layers.{layer_idx}.linear_attn"
+        gdn = self.language_model.model.layers[layer_idx].self_attn
+        block_n = 128
+
+        def _deq(name):
+            w = self._read_host(fm, weight_info, f"{src}.{name}.weight")
+            s = self._read_host(fm, weight_info, f"{src}.{name}.weight_scale_inv")
+            return self._np_block_dequant(w, s, block_n)
+
+        # in_proj_qkvz = concat([in_proj_qkv=[Q|K|V], in_proj_z]) -> [hidden, 2k+2v]
+        qkv = _deq("in_proj_qkv")  # [2k+v, hidden]
+        z = _deq("in_proj_z")  # [v, hidden]
+        qkvz = np.concatenate([qkv, z], axis=0).T  # [hidden, 2k+2v]
+        gdn.in_proj_qkvz.weight.value = self._put(qkvz, (None, "tensor"))
+
+        # in_proj_ba = concat([in_proj_b, in_proj_a]) (both bf16) -> [hidden, 2*n_v]
+        b = self._read_host(fm, weight_info, f"{src}.in_proj_b.weight")
+        a = self._read_host(fm, weight_info, f"{src}.in_proj_a.weight")
+        ba = np.concatenate([b, a], axis=0).T
+        gdn.in_proj_ba.weight.value = self._put(ba, (None, "tensor"))
